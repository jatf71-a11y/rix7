{
  "name": "rix7-portal-inmobiliario",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "slots": "node scripts/slots.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "build:slot": "node scripts/build.mjs --measure",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration:nosupabase": "node scripts/integration-nosupabase.mjs",
    "check:knip": "knip",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "snapshot:pois": "node scripts/generate-poi-snapshot.mjs",
    "check:auth": "node scripts/check-auth-config.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:status": "node scripts/db-push.mjs --status",
    "db:check": "node scripts/db-push.mjs --check",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "check:health": "node scripts/check-health.mjs",
    "vitals": "node scripts/measure-vitals.mjs",
    "check:a11y": "node scripts/audit-a11y.mjs",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "postinstall": "node scripts/sync-maplibre.mjs && node scripts/sync-leaflet-icons.mjs && node scripts/patch-next-og.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^8.55.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "@tanstack/react-virtual": "^3.14.10",
    "@vercel/analytics": "^1.5.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^6.6.0",
    "next": "14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/node": "^20.17.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "knip": "^6.38.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
