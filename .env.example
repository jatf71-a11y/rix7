[TEMPLATE]
[TEMPLATE]
# Supabase Public Keys (Obtenidas en Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui

# URL canónica del sitio (SEO: metadataBase, sitemap, robots, Open Graph).
# En producción debe ser https://rix7.cl — sin barra final.
NEXT_PUBLIC_SITE_URL=https://rix7.cl

# Acceso al Panel Admin sin rol real (solo para entornos de desarrollo).
# En desarrollo (NODE_ENV !== 'production') el acceso ya viene habilitado; esta
# variable sirve para forzarlo también en builds de preview/staging. Nunca en producción.
# NEXT_PUBLIC_SHOW_ADMIN_ENV=1

# Configuración para el Mapa (Centro por defecto: Santiago de Chile)
NEXT_PUBLIC_DEFAULT_MAP_LAT=-33.4190
NEXT_PUBLIC_DEFAULT_MAP_LNG=-70.5870
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=12

# ═══ Avisos por correo de búsquedas guardadas ═══

# Clave de servicio de Supabase (Project Settings -> API -> service_role).
# El job de alertas la necesita para leer las búsquedas de TODAS las personas,
# que es justo lo que impide RLS. NO lleva prefijo NEXT_PUBLIC_ a propósito:
# nunca debe llegar al navegador. Solo se usa desde rutas de servidor.
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Secreto compartido con el cron de GitHub Actions (.github/workflows/alerts-run.yml).
# Sin él, /api/alerts/run responde 503 en lugar de enviar correos.
# ALERTS_CRON_SECRET=una-cadena-larga-aleatoria

# Envío de correo vía Resend (https://resend.com). Sin esta clave los avisos no
# salen: el job lo informa en vez de fingir que se enviaron.
# RESEND_API_KEY=re_tu_clave

# Remitente de los avisos. El dominio debe estar verificado en Resend.
# ALERTS_FROM_EMAIL=Rix7 <avisos@rix7.cl>
